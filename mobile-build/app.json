{
  "expo": {
    "name": "Tracking PDV",
    "slug": "houns-rufin",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "trackingpdv",
    "splash": {
      "image": "./assets/images/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#008840"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trackingpdv.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tracking PDV utilise votre position pour géolocaliser le point de vente et horodater vos saisies terrain.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Tracking PDV suit votre position en arrière-plan pour détecter automatiquement les sorties de la zone autorisée (500 m) autour du point de vente."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.trackingpdv.mobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "INTERNET",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Tracking PDV suit votre position en arrière-plan pour détecter les sorties de zone (rayon de 500 m) et horodater vos ventes.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#008840",
          "sounds": []
        }
      ],
      "expo-splash-screen",
      "expo-font",
      "expo-image",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "80fbfbb2-cdc5-4f72-8ca3-ca302c17648e"
      }
    },
    "owner": "ruffinh22s-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/80fbfbb2-cdc5-4f72-8ca3-ca302c17648e"
    }
  }
}
