# Développement local : remplace cette IP par l'adresse LAN du PC qui exécute
# le backend, puis copie ce fichier en .env.local. Le téléphone doit être sur
# le même Wi-Fi que le PC.
EXPO_PUBLIC_API_URL=https://pdvtrack.afrochicluxe.com/api

# Production EAS : configure EXPO_PUBLIC_API_URL dans l'environnement EAS
# "production" avec https://pdvtrack.afrochicluxe.com/api.
